{
  "scripts": {
    "build": "esbuild ./src/index.ts --sourcemap --bundle --platform=node --outdir=./dist",
    "watch": "npm run build -- --watch",
    "run": "node ./dist/index.js",
    "update": "npx npm-check-updates -u -t minor",
    "update-major": "npx npm-check-updates -u"
  },
  "dependencies": {
    "dotenv": "17.4.2",
    "octokit": "5.0.5"
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "typescript": "7.0.2"
  }
}