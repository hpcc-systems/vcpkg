{
  "name": "abseil",
  "version": "20250127.1",
  "port-version": 4,
  "description": "Abseil is an open-source collection of C++ library code.",
  "homepage": "https://github.com/abseil/abseil-cpp",
  "license": "Apache-2.0",
  "dependencies": [
    { "name": "vcpkg-cmake", "host": true },
    { "name": "vcpkg-cmake-config", "host": true }
  ],
  "features": {
    "cxx17": { "description": "Enable compiler C++17." },
    "test-helpers": {
      "description": "Build Abseil's test helpers",
      "dependencies": [
        { "name": "abseil", "features": [ "cxx17" ] },
        { "name": "gtest", "features": [ "cxx17" ] }
      ]
    }
  }
}